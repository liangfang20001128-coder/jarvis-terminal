# 贾维斯终端 · 桥接服务环境变量示例（复制为 .env 或填入云平台）
JARVIS_PORT=8787
# auto / codex / openai / fallback
JARVIS_AGENT=auto
# 本机 Codex CLI 路径（可选，默认 ChatGPT.app 内置）
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# 云端对话：填入 API Key 后，云端也会有大模型扮演贾维斯
OPENAI_API_KEY=sk-xxxx
# OpenAI 默认：https://api.openai.com/v1；DeepSeek 换为 https://api.deepseek.com/v1
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 用 gpt-4.1-mini；DeepSeek 用 deepseek-chat（或 deepseek-reasoner）
JARVIS_OPENAI_MODEL=deepseek-chat
# 应用启动白名单（仅本机生效）：{"微信":"WeChat"}
JARVIS_LAUNCH={}
# 游戏登录地址（可选）
JARVIS_GAME_URL=
